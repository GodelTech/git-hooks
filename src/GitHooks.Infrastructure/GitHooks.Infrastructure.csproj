<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <AssemblyName>GitHooks.Infrastructure</AssemblyName>
    <RootNamespace>GitHooks.Infrastructure</RootNamespace>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scaffold\Templates\hook.sh" />
    <EmbeddedResource Include="Scaffold\Templates\hook.yaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHooks.Templates\GitHooks.Templates.csproj" />
  </ItemGroup>

</Project>
