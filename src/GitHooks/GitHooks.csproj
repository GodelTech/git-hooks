<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <AssemblyName>GitHooks</AssemblyName>
    <RootNamespace>GitHooks</RootNamespace>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>githooks</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.7" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHooks.Infrastructure\GitHooks.Infrastructure.csproj" />
    <ProjectReference Include="..\GitHooks.Pipeline\GitHooks.Pipeline.csproj" />
    <ProjectReference Include="..\GitHooks.Pipeline.Parser\GitHooks.Pipeline.Parser.csproj" />
    <ProjectReference Include="..\GitHooks.Pipeline.Runner\GitHooks.Pipeline.Runner.csproj" />
  </ItemGroup>

</Project>
