<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <AssemblyName>GitHooks</AssemblyName>
    <RootNamespace>GitHooks</RootNamespace>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>githooks</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHooks.Infrastructure\GitHooks.Infrastructure.csproj" />
    <ProjectReference Include="..\GitHooks.Workflow.Infrastructure\GitHooks.Workflow.Infrastructure.csproj" />
  </ItemGroup>

</Project>
